#!/usr/bin/env bash
# Single source of truth for project checks. Owned by claude-kit: change it in the kit,
# not here (copier update brings it back). Project-specific checks go in scripts/check.d/.
#
#   scripts/check fast FILE...   format + autofix only the given files (never fails)
#   scripts/check stop           quick gate used by the Stop hook and pre-commit (fail-fast)
#   scripts/check ci             stop + secrets scan + project extras in ci mode
#
# Silent on success. On failure prints the failing step and the last 40 lines of its output,
# so an agent reading it spends hundreds of tokens, not thousands.
set -uo pipefail

mode="${1:-stop}"
[ $# -gt 0 ] && shift
cd "$(git rev-parse --show-toplevel 2>/dev/null || pwd)" || exit 1

log="$(mktemp)"
trap 'rm -f "$log"' EXIT

step() { # step NAME CMD...
  local name="$1"
  shift
  if ! "$@" >"$log" 2>&1; then
    echo "✗ $name: $*"
    tail -n 40 "$log"
    exit 1
  fi
}

is_py() { [ -f pyproject.toml ]; }
is_ts() { [ -f package.json ]; }
py() { uv run --quiet "$@"; }
js() { if [ -f pnpm-lock.yaml ]; then pnpm exec "$@"; else npx --no-install "$@"; fi; }

max_lines=800
file_size() { # big files cost tokens on every read and degrade agent edits
  local f n bad=0
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    n=$(wc -l <"$f")
    if [ "$n" -gt "$max_lines" ]; then
      echo "$f has $n lines (max $max_lines): split it by responsibility"
      bad=1
    fi
  done < <(git ls-files -co --exclude-standard -- '*.py' '*.ts' '*.tsx' '*.js' '*.jsx' \
    ':!:**/generated/**' ':!:**/*.gen.*' ':!:**/fixtures/**' 2>/dev/null)
  return $bad
}

fast() {
  local f
  for f in "$@"; do
    [ -f "$f" ] || continue
    case "$f" in
      *.py) is_py && { py ruff format -q "$f"; py ruff check --fix -q "$f"; } ;;
      *.ts | *.tsx | *.js | *.jsx | *.json | *.css) is_ts && js biome check --write "$f" ;;
    esac
  done >/dev/null 2>&1
  return 0
}

stop() {
  step "file size" file_size
  if is_py; then
    step "ruff format" py ruff format --check -q .
    step "ruff lint" py ruff check -q .
    if grep -q '^\[tool.mypy\]' pyproject.toml; then step "mypy" py mypy; fi
    step "pytest" py pytest -x -q
  fi
  if is_ts; then
    step "biome" js biome ci .
    if [ -f tsconfig.json ]; then step "tsc" js tsc --noEmit; fi
    step "vitest" js vitest run --bail 1 --reporter dot
  fi
}

extras() { # scripts/check.d/*.sh belong to the project; they receive the mode
  local x
  for x in scripts/check.d/*.sh; do
    if [ -f "$x" ]; then step "$x" bash "$x" "$mode"; fi
  done
}

secrets() {
  if command -v gitleaks >/dev/null 2>&1; then
    step "gitleaks" gitleaks git --no-banner --redact .
  fi # CI runs the gitleaks action anyway
}

case "$mode" in
  fast) fast "$@" ;;
  stop) stop && extras ;;
  ci) stop && extras && secrets ;;
  *)
    echo "usage: scripts/check fast FILE... | stop | ci" >&2
    exit 64
    ;;
esac
