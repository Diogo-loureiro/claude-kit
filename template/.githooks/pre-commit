#!/usr/bin/env bash
# Git pre-commit (enabled by `git config core.hooksPath .githooks`, which copier runs).
set -euo pipefail

if git diff --cached --name-only | grep -qE '\.rej$'; then
  echo "pre-commit: resolve and delete the .rej files left by copier update first" >&2
  exit 1
fi
if git diff --cached -U0 | grep -qE '^\+(<<<<<<<|>>>>>>>) '; then
  echo "pre-commit: conflict markers in staged changes" >&2
  exit 1
fi

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks git --pre-commit --staged --no-banner --redact
else
  echo "pre-commit: gitleaks not installed, secrets scan skipped (CI still runs it)" >&2
fi

scripts/check stop
