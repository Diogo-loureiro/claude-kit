# Owned by claude-kit. The agent may not edit it: fix the code, not the rule.
line-length = 100
# No target-version: ruff infers it from requires-python in pyproject.toml, so a 3.11 project
# never gets autofixes that need 3.12 syntax.

[lint]
# C90: complexity, PL: pylint limits, S: security (bandit), DTZ: no naive datetimes (money + dates)
select = ["E", "F", "W", "I", "B", "UP", "SIM", "C90", "PL", "RUF", "S", "DTZ"]
# PLC0415: lazy imports are legitimate (optional extras, startup time, import cycles).
ignore = ["PLC0415"]

[lint.mccabe]
max-complexity = 10

[lint.pylint]
max-statements = 50
# Keyword-only arguments count too; 6 forced artificial parameter objects (scforge: 111 noqa).
max-args = 8

[lint.per-file-ignores]
"tests/**" = ["S101", "PLR2004"]
