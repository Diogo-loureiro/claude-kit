# Owned by claude-kit. The agent may not edit it: fix the code, not the rule.
line-length = 100
target-version = "py312"

[lint]
# C90: complexity, PL: pylint limits, S: security (bandit), DTZ: no naive datetimes (money + dates)
select = ["E", "F", "W", "I", "B", "UP", "SIM", "C90", "PL", "RUF", "S", "DTZ"]

[lint.mccabe]
max-complexity = 10

[lint.pylint]
max-statements = 50
max-args = 6

[lint.per-file-ignores]
"tests/**" = ["S101", "PLR2004"]
